---
import BaseLayout from '../layouts/BaseLayout.astro';
import { priorityMatrix, flows } from '../data/audit.js';

const flowTitle = Object.fromEntries(flows.map((f) => [f.id, f.title]));

const impacts = ['High', 'Medium', 'Low'];
const efforts = ['Quick', 'Medium', 'Large'];

// Priority weight → cell intensity (High impact + Quick effort = hottest)
const iW = { High: 3, Medium: 2, Low: 1 };
const eW = { Quick: 3, Medium: 2, Large: 1 };
const cellItems = (imp, eff) =>
  priorityMatrix.filter((p) => p.impact === imp && p.effort === eff);

const statusMeta = {
  BUG: { color: 'var(--color-danger)', tint: 'var(--color-danger-tint)' },
  MISSING: { color: 'var(--color-brand)', tint: 'var(--color-brand-tint)' },
  PARTIAL: { color: 'var(--color-warn)', tint: 'var(--color-warn-tint)' },
};

const doFirst = priorityMatrix.filter((p) => p.impact === 'High' && p.effort === 'Quick');

const counts = {
  total: priorityMatrix.length,
  bug: priorityMatrix.filter((p) => p.status === 'BUG').length,
  missing: priorityMatrix.filter((p) => p.status === 'MISSING').length,
  partial: priorityMatrix.filter((p) => p.status === 'PARTIAL').length,
};
---

<BaseLayout title="Priority Matrix · Kisah Flow Audit">
  <section class="pm-hero">
    <div class="shell">
      <p class="eyebrow" data-reveal>Priority action matrix</p>
      <h1 class="pm-hero__title" data-reveal style="--reveal-delay:.05s">
        What to ship, in what order.
      </h1>
      <p class="pm-hero__lede" data-reveal style="--reveal-delay:.12s">
        Every recommendation plotted by expected revenue / trust impact against
        implementation effort. Start top-left — high impact, low effort — and
        work outward.
      </p>

      <div class="pm-hero__stats" data-reveal style="--reveal-delay:.18s">
        <span><strong data-count={counts.total}>0</strong> actions</span>
        <span class="pm-pip is-bug"><strong data-count={counts.bug}>0</strong> bugs</span>
        <span class="pm-pip is-missing"><strong data-count={counts.missing}>0</strong> missing</span>
        <span class="pm-pip is-partial"><strong data-count={counts.partial}>0</strong> partial</span>
      </div>
    </div>
  </section>

  <!-- ================= QUADRANT ================= -->
  <section class="section">
    <div class="shell">
      <div class="quad-wrap" data-reveal>
        <span class="quad-axis quad-axis--y">Impact →</span>
        <div class="quad">
          <div class="quad__corner"></div>
          {efforts.map((e) => <div class="quad__colhead">{e} effort</div>)}
          {
            impacts.map((imp) => (
              <>
                <div class="quad__rowhead">{imp} impact</div>
                {
                  efforts.map((eff) => {
                    const items = cellItems(imp, eff);
                    const score = iW[imp] * eW[eff];
                    const level = score >= 8 ? 3 : score >= 5 ? 2 : score >= 3 ? 1 : 0;
                    return (
                      <button
                        class:list={['quad__cell', `lvl-${level}`, { 'is-prime': imp === 'High' && eff === 'Quick' }]}
                        data-cell
                        data-impact={imp}
                        data-effort={eff}
                        disabled={items.length === 0}
                        aria-label={`${imp} impact, ${eff} effort: ${items.length} actions`}
                      >
                        <span class="quad__count">{items.length}</span>
                        <span class="quad__dots">
                          {items.map((it) => (
                            <span class="quad__dot" style={`background:${statusMeta[it.status].color}`} />
                          ))}
                        </span>
                        {imp === 'High' && eff === 'Quick' && (
                          <span class="quad__flag">Do first</span>
                        )}
                      </button>
                    );
                  })
                }
              </>
            ))
          }
        </div>
        <span class="quad-axis quad-axis--x">Effort →</span>
      </div>
      <p class="quad-hint" data-reveal>
        Tip — click any cell to filter the list below. Brighter cells are higher
        priority.
      </p>
    </div>
  </section>

  <!-- ================= FILTERABLE LIST ================= -->
  <section class="section section--cream" id="actions">
    <div class="shell">
      <header class="sec-head2" data-reveal>
        <h2>All {counts.total} actions</h2>
        <div class="pm-search">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="m11 11 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input id="pm-q" type="search" placeholder="Search actions…" aria-label="Search actions" />
        </div>
      </header>

      <div class="pm-filters" data-reveal>
        <div class="pm-fgroup" data-group="status">
          <span class="pm-flabel">Status</span>
          {['BUG', 'MISSING', 'PARTIAL'].map((s) => (
            <button class="pm-chip" data-filter="status" data-value={s} style={`--c:${statusMeta[s].color};--t:${statusMeta[s].tint}`}>{s}</button>
          ))}
        </div>
        <div class="pm-fgroup" data-group="impact">
          <span class="pm-flabel">Impact</span>
          {impacts.map((i) => <button class="pm-chip" data-filter="impact" data-value={i}>{i}</button>)}
        </div>
        <div class="pm-fgroup" data-group="effort">
          <span class="pm-flabel">Effort</span>
          {efforts.map((e) => <button class="pm-chip" data-filter="effort" data-value={e}>{e}</button>)}
        </div>
        <button id="pm-reset" class="pm-reset" hidden>Clear all</button>
      </div>

      <p class="pm-resultcount" data-reveal>
        Showing <span id="pm-count">{counts.total}</span> of {counts.total}
      </p>

      <ul class="pm-list" id="pm-list">
        <li class="pm-list__head" aria-hidden="true">
          <span>Action</span>
          <span>Status</span>
          <span>Impact</span>
          <span>Effort</span>
          <span>Detail</span>
        </li>
        {
          priorityMatrix.map((p) => (
            <li
              class="pm-row"
              data-row
              data-status={p.status}
              data-impact={p.impact}
              data-effort={p.effort}
              data-text={`${p.action} ${p.note} ${flowTitle[p.flow] ?? ''}`.toLowerCase()}
              style={`--c:${statusMeta[p.status].color};--t:${statusMeta[p.status].tint}`}
            >
              <a class="pm-row__action" href={`/audit#${p.flow}`}>
                <span class="pm-row__title">{p.action}</span>
                <span class="pm-row__flow">{flowTitle[p.flow]}</span>
              </a>
              <span class="pm-row__status"><span class="pm-row__pill">{p.status}</span></span>
              <span class="pm-row__impact" data-impact={p.impact}>{p.impact}</span>
              <span class="pm-row__effort">{p.effort}</span>
              <span class="pm-row__note">{p.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="pm-empty" id="pm-empty" hidden>No actions match these filters.</p>
    </div>
  </section>

  <!-- ================= DO FIRST ================= -->
  <section class="section">
    <div class="shell">
      <div class="dofirst" data-reveal>
        <div class="dofirst__copy">
          <span class="eyebrow">This week</span>
          <h2>Four quick wins, all high impact.</h2>
          <p>High-impact fixes that take a line of code or a content change. No reason to wait.</p>
        </div>
        <ol class="dofirst__list">
          {
            doFirst.map((p, i) => (
              <li>
                <span class="dofirst__num">{String(i + 1).padStart(2, '0')}</span>
                <a href={`/audit#${p.flow}`}>
                  <strong>{p.action}</strong>
                  <span>{p.note}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: clamp(3rem, 7vw, 6rem); }
  .section--cream { background: var(--color-cream); }

  .pm-hero {
    background: radial-gradient(120% 90% at 100% 0%, var(--color-cream), transparent 60%), var(--color-canvas);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .pm-hero__title { margin-top: 1rem; font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; }
  .pm-hero__lede { margin-top: 1.3rem; max-width: 56ch; font-size: clamp(1rem, 1.5vw, 1.15rem); color: var(--color-body); }
  .pm-hero__stats { display: flex; flex-wrap: wrap; gap: 1.6rem; margin-top: 2rem; font-size: 0.92rem; color: var(--color-body); }
  .pm-hero__stats strong { font-family: var(--font-display); font-size: 1.3rem; color: var(--color-ink); margin-right: 0.35rem; }
  .pm-pip { display: inline-flex; align-items: center; }
  .pm-pip::before { content: ''; width: 9px; height: 9px; border-radius: 3px; margin-right: 0.5rem; }
  .pm-pip.is-bug::before { background: var(--color-danger); }
  .pm-pip.is-missing::before { background: var(--color-brand); }
  .pm-pip.is-partial::before { background: var(--color-warn); }

  /* ---------- Quadrant ---------- */
  .quad-wrap { position: relative; padding-left: 1.6rem; padding-bottom: 1.6rem; }
  .quad-axis {
    position: absolute;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .quad-axis--y { left: -0.4rem; top: 50%; transform: rotate(-90deg) translateX(50%); transform-origin: left; }
  .quad-axis--x { left: 50%; bottom: -0.2rem; transform: translateX(-50%); }

  .quad {
    display: grid;
    grid-template-columns: auto repeat(3, 1fr);
    gap: 0.6rem;
  }
  .quad__corner { }
  .quad__colhead, .quad__rowhead {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-body);
    display: flex;
    align-items: center;
  }
  .quad__colhead { justify-content: center; padding-bottom: 0.3rem; }
  .quad__rowhead { padding-right: 0.8rem; white-space: nowrap; }

  .quad__cell {
    position: relative;
    min-height: clamp(92px, 13vw, 132px);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.85rem;
    text-align: left;
    transition: transform 0.25s var(--ease-out-soft), box-shadow 0.25s ease, border-color 0.25s ease, outline-color 0.2s ease;
    outline: 2px solid transparent;
    outline-offset: -2px;
  }
  .quad__cell.lvl-1 { background: color-mix(in srgb, var(--color-brand) 6%, var(--color-paper)); }
  .quad__cell.lvl-2 { background: color-mix(in srgb, var(--color-brand) 14%, var(--color-paper)); }
  .quad__cell.lvl-3 { background: color-mix(in srgb, var(--color-brand) 24%, var(--color-paper)); border-color: color-mix(in srgb, var(--color-brand) 40%, transparent); }
  .quad__cell:not(:disabled):hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .quad__cell.is-active { outline-color: var(--color-brand); box-shadow: var(--shadow-glow); }
  .quad__cell:disabled { opacity: 0.5; cursor: default; }
  .quad__count { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--color-ink); line-height: 1; }
  .quad__dots { display: flex; flex-wrap: wrap; gap: 4px; max-width: 100%; }
  .quad__dot { width: 8px; height: 8px; border-radius: 50%; }
  .quad__flag {
    position: absolute;
    top: 0.7rem; right: 0.7rem;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-brand);
    padding: 0.25em 0.6em;
    border-radius: var(--radius-pill);
  }
  .quad-hint { margin-top: 1.2rem; font-size: 0.86rem; color: var(--color-muted); }

  @media (max-width: 640px) {
    .quad { gap: 0.4rem; font-size: 0.9rem; }
    .quad__colhead, .quad__rowhead { font-size: 0.6rem; }
    .quad__rowhead { writing-mode: vertical-rl; transform: rotate(180deg); }
  }

  /* ---------- Filters + list ---------- */
  .sec-head2 {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;
  }
  .sec-head2 h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .pm-search {
    display: flex; align-items: center; gap: 0.55rem;
    background: var(--color-paper);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-pill);
    padding: 0.6rem 1.1rem;
    color: var(--color-muted);
    min-width: 240px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .pm-search:focus-within { border-color: var(--color-brand); box-shadow: var(--shadow-glow); }
  .pm-search input { border: 0; outline: 0; background: none; font: inherit; font-size: 0.92rem; color: var(--color-ink); width: 100%; }

  .pm-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.4rem; margin-bottom: 1.2rem; }
  .pm-fgroup { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }
  .pm-flabel { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); margin-right: 0.2rem; }
  .pm-chip {
    --c: var(--color-body); --t: var(--color-paper);
    font-size: 0.8rem; font-weight: 700;
    padding: 0.4em 0.85em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hair-strong);
    background: var(--color-paper);
    color: var(--color-body);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .pm-chip:hover { border-color: var(--c); color: var(--c); }
  .pm-chip.is-on { background: var(--c); border-color: var(--c); color: #fff; }
  .pm-reset {
    font-size: 0.78rem; font-weight: 700; color: var(--color-brand);
    background: none; border: 0; cursor: pointer; padding: 0.4em 0.6em;
    text-decoration: underline; text-underline-offset: 3px;
  }
  .pm-resultcount { font-size: 0.84rem; color: var(--color-muted); margin-bottom: 1rem; }
  .pm-resultcount span { font-weight: 800; color: var(--color-ink); }

  .pm-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .pm-list__head, .pm-row {
    display: grid;
    grid-template-columns: 2.4fr 0.9fr 0.7fr 0.7fr 1.6fr;
    gap: 1rem;
    align-items: center;
  }
  .pm-list__head {
    padding: 0 1.2rem 0.4rem;
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-muted);
  }
  .pm-row {
    padding: 1rem 1.2rem;
    background: var(--color-paper);
    border: 1px solid var(--color-hair-soft);
    border-left: 3px solid var(--c);
    border-radius: var(--radius-lg);
    transition: transform 0.2s var(--ease-out-soft), box-shadow 0.2s ease, opacity 0.25s ease;
  }
  .pm-row:hover { transform: translateX(3px); box-shadow: var(--shadow-card); }
  .pm-row.is-hidden { display: none; }
  .pm-row__action { display: flex; flex-direction: column; gap: 0.15rem; }
  .pm-row__title { font-weight: 700; color: var(--color-ink); font-size: 0.96rem; line-height: 1.35; }
  .pm-row__action:hover .pm-row__title { color: var(--color-brand); }
  .pm-row__flow { font-size: 0.74rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .pm-row__pill {
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.05em;
    padding: 0.3em 0.7em; border-radius: var(--radius-pill);
    background: var(--t); color: var(--c);
  }
  .pm-row__impact { font-weight: 700; font-size: 0.88rem; }
  .pm-row__impact[data-impact='High'] { color: var(--color-danger); }
  .pm-row__impact[data-impact='Medium'] { color: var(--color-amber); }
  .pm-row__impact[data-impact='Low'] { color: var(--color-muted); }
  .pm-row__effort { font-size: 0.88rem; color: var(--color-body); }
  .pm-row__note { font-size: 0.84rem; color: var(--color-body); }
  .pm-empty { padding: 2rem; text-align: center; color: var(--color-muted); }

  @media (max-width: 760px) {
    .pm-list__head { display: none; }
    .pm-row {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 1rem;
    }
    .pm-row__action { grid-column: 1 / -1; }
    .pm-row__note { grid-column: 1 / -1; }
  }

  /* ---------- Do first ---------- */
  .dofirst {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--color-indigo);
    border-radius: var(--radius-xl);
  }
  .dofirst__copy .eyebrow { color: var(--color-brand-soft); }
  .dofirst__copy h2 { color: #fff; font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0.6rem 0 0.7rem; }
  .dofirst__copy p { color: rgba(255,255,255,0.66); }
  .dofirst__list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .dofirst__list li { display: flex; align-items: center; gap: 1rem; padding: 0.95rem 1.1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); transition: background 0.25s ease, transform 0.25s ease; }
  .dofirst__list li:hover { background: rgba(193,100,82,0.16); transform: translateX(4px); }
  .dofirst__num { font-family: var(--font-display); font-weight: 700; color: var(--color-brand-soft); font-size: 1.1rem; }
  .dofirst__list a { display: flex; flex-direction: column; gap: 0.1rem; }
  .dofirst__list strong { color: #fff; font-size: 0.96rem; }
  .dofirst__list span { color: rgba(255,255,255,0.55); font-size: 0.8rem; }
  @media (max-width: 720px) { .dofirst { grid-template-columns: 1fr; } }
</style>

<script>
  function bindMatrix() {
    const list = document.getElementById('pm-list');
    if (!list || list.dataset.bound) return;
    list.dataset.bound = 'true';

    const rows = Array.from(list.querySelectorAll('[data-row]'));
    const chips = Array.from(document.querySelectorAll('.pm-chip'));
    const cells = Array.from(document.querySelectorAll('[data-cell]'));
    const search = document.getElementById('pm-q');
    const countEl = document.getElementById('pm-count');
    const emptyEl = document.getElementById('pm-empty');
    const resetBtn = document.getElementById('pm-reset');

    const active = { status: new Set(), impact: new Set(), effort: new Set() };
    let query = '';

    function apply() {
      let shown = 0;
      rows.forEach((row) => {
        const s = row.dataset.status, i = row.dataset.impact, e = row.dataset.effort;
        const ok =
          (active.status.size === 0 || active.status.has(s)) &&
          (active.impact.size === 0 || active.impact.has(i)) &&
          (active.effort.size === 0 || active.effort.has(e)) &&
          (query === '' || row.dataset.text.includes(query));
        row.classList.toggle('is-hidden', !ok);
        if (ok) shown++;
      });
      if (countEl) countEl.textContent = String(shown);
      if (emptyEl) emptyEl.hidden = shown !== 0;
      const anyFilter = query || active.status.size || active.impact.size || active.effort.size;
      if (resetBtn) resetBtn.hidden = !anyFilter;
      // sync cell active states
      cells.forEach((c) => {
        const on =
          active.impact.size === 1 && active.impact.has(c.dataset.impact) &&
          active.effort.size === 1 && active.effort.has(c.dataset.effort);
        c.classList.toggle('is-active', on);
      });
    }

    function syncChips() {
      chips.forEach((ch) => {
        const g = ch.dataset.filter;
        ch.classList.toggle('is-on', active[g].has(ch.dataset.value));
      });
    }

    chips.forEach((ch) => {
      ch.addEventListener('click', () => {
        const g = ch.dataset.filter, v = ch.dataset.value;
        active[g].has(v) ? active[g].delete(v) : active[g].add(v);
        syncChips();
        apply();
      });
    });

    cells.forEach((cell) => {
      if (cell.disabled) return;
      cell.addEventListener('click', () => {
        const imp = cell.dataset.impact, eff = cell.dataset.effort;
        const already = cell.classList.contains('is-active');
        active.impact.clear();
        active.effort.clear();
        if (!already) { active.impact.add(imp); active.effort.add(eff); }
        syncChips();
        apply();
        document.getElementById('actions')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    search?.addEventListener('input', (e) => {
      query = e.target.value.trim().toLowerCase();
      apply();
    });

    resetBtn?.addEventListener('click', () => {
      active.status.clear(); active.impact.clear(); active.effort.clear();
      query = ''; if (search) search.value = '';
      syncChips(); apply();
    });

    apply();
  }
  document.addEventListener('astro:page-load', bindMatrix);
  if (document.readyState !== 'loading') bindMatrix();
</script>
